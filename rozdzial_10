class Program
{
    static void Main()
    {
        int liczba;
        bool poprawne;

        do
        {
            Console.Write("Podaj ocenę (10–99): ");
            string wejscie = Console.ReadLine();

            poprawne = int.TryParse(wejscie, out liczba) && liczba >= 10 && liczba <= 99;
            if (!poprawne)

            {
                Console.WriteLine("Błąd: liczba musi być całkowita od 10 do 99");
            }
        } while (!poprawne);
        if(liczba %2 == 0)
        {
            Console.WriteLine($"Zapisana liczba: {liczba} jest parzysta." );
        }else
        {
            Console.WriteLine($"Zapisana liczba: {liczba} jest nieparzysta.");
        }
    }
}

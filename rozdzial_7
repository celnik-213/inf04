using System.Collections.Generic;
using System.Diagnostics.CodeAnalysis;
using System.Linq;

Console.WriteLine("Witaj w programie");
List<int> liczby = new List<int>();
int podana = 1;
while(podana != 0)
{
    Console.Write("Podaj liczbe do listy: ");
    podana = int.Parse(Console.ReadLine());
    if (podana != 0)
    {
        liczby.Add(podana);
    }

}
for (int i = liczby.Count -1; i>= 0 ; i--)
{
    if (liczby[i] < 0)
    {
        liczby.RemoveAt(i);
    }
}

for (int i = 0; i < liczby.Count; i++)
{
    Console.Write(liczby[i]+ ", ");
}
int suma = liczby.Sum();
int elementy = liczby.Count();
Console.WriteLine($"\nSuma wprowadzonych liczb: {suma} Liczba elementow w liscie: {elementy}");

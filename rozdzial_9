using System.Collections.Generic;
using System.Diagnostics.CodeAnalysis;
using System.Linq;
class Program
{
    static void WypelnijZestaw(int[] liczby, Random generator)
    {
        for(int i = 0; i < liczby.Length; i++)
        {
            liczby[i] = generator.Next(1, 50);
        }
    }

    static void WyswietlZestaw(int numer, int[] liczby)
    {
        Console.WriteLine($"Zestaw {numer}:");
        foreach (int liczba in liczby)
        {
            Console.Write(liczba + " ");
        }
    }

    static int IleParzystych(int[] liczby)
    {
        int licznik = 0;
        foreach (int liczba in liczby)
        {
            if(liczba % 2 == 0)
            {
                licznik++;
            }
        }
        return licznik;
    }
    static void Main()
    {

        Random generator = new Random();

        Console.Write("Ile zestawów lotto chcesz wylosować? ");
        int n = Convert.ToInt32(Console.ReadLine());

        for (int zestaw = 1; zestaw <= n; zestaw++)
        {
            int[] liczby = new int[6];
            WypelnijZestaw(liczby, generator);
            WyswietlZestaw(zestaw, liczby);
            int iloscParzystych = IleParzystych(liczby);
            Console.WriteLine($" Ilosc parzystych: {iloscParzystych}");
        }
    }
}
